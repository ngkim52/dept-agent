# ==== 부서장 페르소나 에이전트 환경변수 ====
# 이 파일을 프로젝트 루트의 .env 로 복사하거나(app/.env) docker compose의 env_file로 사용

# --- 데이터 ---
# DB 파일 위치 (Docker 볼륨: /app/data)
DATA_DIR=./data
DATABASE_URL=./data/dept.db

# --- RAGFlow (외부) ---
# 관리자가 부여받은 RAGFlow API 키
RAGFLOW_BASE_URL=https://ragflow.ax-demo.com
RAGFLOW_API_KEY=

# RAG 검색 옵션
RAG_TOP_K=10
RAG_SIMILARITY_THRESHOLD=0.2

# --- LLM (LiteLLM 게이트웨이 → DeepSeek) ---
LLM_BASE_URL=https://litellm.ax-demo.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash

# --- 웹 검색 (Serper/Tavily) — 선택. 없으면 websearch 결과 없음 ---
OPENROUTER_API_KEY=
# (옵션) SERPER_API_KEY / TAVILY_API_KEY

# --- 파이썬 데이터 도구 (Docker) ---
# 컨테이너 기본 경로. 로컬의 경우 자신의 python 경로 지정
PYTHON_BIN=/usr/bin/python3

# --- 인증 ---
ALLOWED_EMAIL_DOMAINS=shinhan.com,shinhanlife.co.kr
SESSION_COOKIE_NAME=dept_session
SESSION_TTL_MS=604800000

# HTTPS 앞단(프록시)에서만 Secure 쿠키. 로컬 http 테스트 시 false
COOKIE_SECURE=false

# --- 관리자 계정 (seed 시) ---
# npm run db:seed 실행 시 이 계정으로 admin 생성 (없으면 스킵)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- 모델 reasoning(추론) ---
# deepseek 계열은 reasoning 지원. false로 끄면 추론 패널에 안 표시
LLM_REASONING=true
